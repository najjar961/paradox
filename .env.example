# Chat model: ollama | openai | anthropic | echo (echo = offline stub for testing the UI)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible server works (vLLM, LM Studio, ...)

# Embeddings: ollama | openai | hash (hash = keyword-only offline fallback)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small

# Sessions: all data is dropped on sign-out, after this idle time, or at max age
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Limits
MAX_UPLOAD_MB=15
MAX_CHUNKS_PER_USER=5000
MAX_WORKSPACES_PER_USER=10
TOP_K=5
# Documents up to this size (characters, all files in a workspace together) are sent
# to the model whole, so it can summarise and edit them. Larger sets use passage search.
FULL_DOC_CHARS=24000
# Ollama context window in tokens. Ollama's default is too small for whole documents.
OLLAMA_NUM_CTX=12288

# Set to false ONLY when testing over plain http://localhost
COOKIE_SECURE=true
